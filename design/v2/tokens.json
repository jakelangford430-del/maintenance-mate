{
  "color": {
    "navy-950": "#0B1626",
    "navy-900": "#101D30",
    "navy-700": "#22324B",
    "navy-500": "#4A5A74",
    "navy-50": "#EEF1F5",
    "platinum": "#E4E6EA",
    "platinum-300": "#C9CDD4",
    "silver-700": "#5B6370",
    "ivory": "#F8F5EF",
    "ivory-2": "#F2EDE4",
    "paper": "#FFFDF9",
    "ink": "#161B24",
    "champagne": "#C2A574",
    "champagne-ink": "#7B6136"
  },
  "status": {
    "safe": {
      "fg": "#2F6B50",
      "bg": "#E6F0EA",
      "icon": "lucide circle-check"
    },
    "watch": {
      "fg": "#7A5B0C",
      "bg": "#F6EED6",
      "icon": "lucide clock"
    },
    "at-risk": {
      "fg": "#A4481A",
      "bg": "#F9E7DC",
      "icon": "lucide triangle-alert"
    },
    "critical": {
      "fg": "#9E2626",
      "bg": "#F7E1E1",
      "icon": "lucide octagon-alert"
    }
  },
  "font": {
    "display": "Cormorant Garamond 500 (+italic accent)",
    "ui": "Inter 400/500/600"
  },
  "fontSize": {
    "cap": 12,
    "sm": 15,
    "md": 17,
    "lg": 20,
    "h3": 28,
    "h2": 40,
    "h1": 64,
    "h1-mobile": 42
  },
  "lineHeight": {
    "display": 1.08,
    "body": 1.65
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    40,
    64,
    96,
    128
  ],
  "radius": {
    "sm": 8,
    "md": 14,
    "lg": 24,
    "pill": 999
  },
  "shadow": {
    "soft": "0 10px 30px -12px rgba(16,29,48,.14)",
    "lift": "0 24px 60px -24px rgba(16,29,48,.28)"
  },
  "blur": "saturate(140%) blur(14px)",
  "ease": "cubic-bezier(.2,.7,.2,1)"
}