{
  "name": "Maintenance Mate",
  "version": "1.0.0",
  "color": {
    "navy": "#0F1B3D", "navy-2": "#1B2B5E", "navy-deep": "#0A1230",
    "orange": "#FF6B3D", "orange-ink": "#A83A12", "orange-tint": "#FFE3D6",
    "teal": "#19C3A8", "teal-tint": "#D3F6EF",
    "yellow": "#FFC93C", "yellow-tint": "#FFF1C9",
    "sky": "#8FD3FF", "sky-tint": "#DCEEFF",
    "ground": "#EEF1FA", "line": "#CBD3EC", "muted": "#3D4A73", "paper": "#FFFFFF"
  },
  "status": {
    "safe": {"fg": "#0B6B5A", "bg": "#D3F6EF"},
    "watch": {"fg": "#7A5B0C", "bg": "#FFF1C9"},
    "risk": {"fg": "#A83A12", "bg": "#FFE3D6"},
    "critical": {"fg": "#B3202A", "bg": "#FFE0E0"}
  },
  "font": {"display": "Bricolage Grotesque 600-800", "ui": "Manrope 400-800", "mono": "JetBrains Mono"},
  "radius": {"sm": 8, "md": 14, "lg": 20, "pill": 999},
  "depth": {"soft": "3px 3px 0 #0F1B3D", "lift": "5px 5px 0 #0F1B3D"},
  "pairings": {
    "navy on orange": "approx 6.0:1",
    "navy on teal": "approx 7.5:1",
    "navy on yellow": "high (above 10:1)",
    "white on navy": "approx 17:1",
    "orange-ink on ground": "approx 5.6:1",
    "muted on ground": "approx 7.6:1",
    "status text on its tint": "5.2:1 to 5.6:1"
  },
  "rules": [
    "White text never goes on orange or teal. Use navy.",
    "Plain orange is for fills, dots and focus rings. Text on light uses orange-ink.",
    "One primary (orange) button per screen.",
    "Status is icon shape + label + colour, never colour alone."
  ]
}
