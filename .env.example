# Set these as Netlify environment variables (never commit real values)
SESSION_SECRET=change-me-long-random-string
# JSON map of email -> pbkdf2 hash, generate with: python3 netlify-site/add_user.py you@example.com
PORTAL_USERS={}
# Comma-separated admin emails (unset = every password user is admin)
PORTAL_ADMINS=
# Hashed shared PINs (staff / property managers)
PORTAL_PIN_HASH=
PORTAL_PM_PIN_HASH=
# Feature flags: "1" to enable the public supplier join form / public request form
PORTAL_PUBLIC_JOIN=
PORTAL_PUBLIC_REQUEST=
